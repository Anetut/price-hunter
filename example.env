# copy this file to .env and put your own values (or just use gui.py)

# the product page you want to watch
PRODUCT_URL=https://www.your-product-page.com
# css selector of the price (right click the price > Inspect), this one works for emag
PRICE_SELECTOR=.product-new-price

# you get an email when the price goes under this (just the number, no currency)
TARGET_PRICE=3900.00

# gmail that sends the alert + its app password (not your normal password!)
# make one here: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=

# where the alert goes
EMAIL_TO=you@gmail.com
